# vars/urltest.nix
# Параметры для outbound type=urltest (автовыбор лучшего сервера по пингу).
{
  interval = "1m";             # как часто перепроверять
  tolerance = 300;              # миллисекунды — в пределах этого считается что текущий лучший
  idle_timeout = "30m";         # через сколько простоя сбросить выбор
  interrupt_exist_connections = false;  # не рвать текущие соединения при переключении
}